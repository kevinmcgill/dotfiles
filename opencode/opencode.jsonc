{
  "permission": {
    "bash": {
      "script/*": "deny",
      "*": "allow"
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "home-assistant": {
        "type": "remote",
        "url": "http://homeassistant.local:8123/api/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.secrets/opencode/ha-token}"
        }
      },
      "Buildkite": {
        "type": "remote",
        "url": "https://mcp.buildkite.com/mcp",
        "oauth": {}
      }
    }
  }
}
